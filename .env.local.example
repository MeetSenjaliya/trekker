# Canonical origin, used for metadataBase / canonical URLs / OG image URLs / sitemap.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000.
# MUST be set in production — otherwise every shared link advertises localhost.
NEXT_PUBLIC_SITE_URL=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: For server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cloudflare R2 — where uploaded images live (src/app/api/upload/route.ts).
# The first four are server-only (the S3 API token scoped to the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=trekker-media
# The bucket's public base URL — https://pub-….r2.dev or a custom domain, no
# trailing slash. Stored URLs, <Image> remotePatterns and CSP img-src use it.
NEXT_PUBLIC_R2_PUBLIC_URL=

# Sentry (error monitoring) — leave blank to disable; Sentry is a no-op without a DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source-map upload (build-time, set in CI/Vercel only — never client-exposed).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Content-Security-Policy: blank ships it as Report-Only (reports, blocks nothing).
# Set to 1 to enforce, once the Sentry CSP reports are clean. Unset to roll back.
CSP_ENFORCE=

